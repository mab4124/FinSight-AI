# ─────────────────────────────────────────────────────────────────────────────
# Financial Document Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Financial Document Intelligence Platform"
APP_VERSION=0.1.0
# Set to true for verbose SQL logging and debug log level
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL — used by FastAPI / SQLAlchemy at runtime
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintel
# Sync URL — used by Alembic for migrations (requires psycopg2)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/fintel

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Ollama runs locally and exposes an OpenAI-compatible API at port 11434.
# The backend calls this endpoint — model weights stay on the host machine,
# not inside any Docker container.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120

# ── Embedding Configuration ───────────────────────────────────────────────────
# Using nomic-embed-text via Ollama (pull with: ollama pull nomic-embed-text)
# Dimension 768 MUST match the VECTOR(768) column in document_chunks.
# Changing this requires a new Alembic migration and re-embedding all documents.
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ── RAG Pipeline Tuning ───────────────────────────────────────────────────────
# top_k: number of document chunks retrieved per query
# chunk_size: approximate words per chunk (600–800 is a good starting point)
# chunk_overlap: words of overlap between adjacent chunks (prevents boundary loss)
RAG_TOP_K=5
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
